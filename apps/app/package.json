{
	"name": "app",
	"version": "0.10.1",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shoto290/OpenNest.git"
	},
	"type": "module",
	"scripts": {
		"dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"dev:web": "vite",
		"build": "tsc -b && vite build",
		"serve": "vite preview",
		"types": "tsc -b",
		"test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml --features fake-claude",
		"test:unit": "vitest run",
		"test:live": "cargo test --manifest-path src-tauri/Cargo.toml --features fake-claude --test real_claude -- --ignored --test-threads=1",
		"lint": "biome lint",
		"lint:fix": "biome check --assist-enabled=true --unsafe --write .",
		"tauri:build": "tauri build"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-opener": "^2.5.2",
		"@tauri-apps/plugin-os": "^2.3.2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@workspace/ui": "workspace:*",
		"react": "^19.2.6",
		"react-dom": "^19.2.6"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4",
		"@tauri-apps/cli": "^2",
		"@types/node": "^24",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6",
		"happy-dom": "^20.11.6",
		"vite": "^8",
		"vitest": "4.1.10"
	}
}
