	{
		"name": "superset",
		"title": "Superset",
		"description": "Run workspaces, terminals, agents and tasks.",
		"config": {
			"type": "http",
			"url": "https://api.superset.sh/mcp",
			"headers": { "Authorization": "Bearer ${SUPERSET_API_KEY}" }
