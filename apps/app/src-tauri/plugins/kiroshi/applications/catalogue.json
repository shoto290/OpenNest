			"tasks_delete",
			"tasks_statuses_list"
		],
		"logo": "applications/logos/superset.svg",
		"install": {
			"kind": "key",
			"name": "Authorization",
			"secret": "SUPERSET_API_KEY",
			"description": "A Superset API key."
		}
