		"description": "Read and change repositories, issues and pull requests.",
		"config": { "type": "http", "url": "https://api.githubcopilot.com/mcp/" },
		"tools": [
			"get_me",
			"search_repositories",
			"get_file_contents",
			"list_branches",
			"list_commits",
			"create_branch",
			"create_or_update_file",
			"push_files",
			"search_code",
			"list_issues",
			"search_issues",
			"issue_read",
			"issue_write",
			"add_issue_comment",
			"list_pull_requests",
			"search_pull_requests",
			"pull_request_read",
			"create_pull_request",
			"update_pull_request",
			"merge_pull_request"
		],
		"logo": "applications/logos/github.svg",
		"install": { "kind": "oauth" }
	},
