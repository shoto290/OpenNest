{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "OpenNest",
	"version": "0.1.2",
	"identifier": "com.opennest.app",
	"build": {
		"beforeDevCommand": "bun run dev:web",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"security": {
			"assetProtocol": {
				"enable": true,
				"scope": ["$APPDATA/avatars/*"]
			}
		},
		"windows": [
			{
				"title": "OpenNest",
				"dragDropEnabled": false,
				"visible": false,
				"width": 1280,
				"height": 832,
				"minWidth": 1024,
				"minHeight": 680,
				"center": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": { "x": 22, "y": 26 }
			}
		]
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://github.com/shoto290/OpenNest/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMkVBNjdDQ0I1QTc2N0QKUldSOWRsckxmS1l1ajArcW54RTM3R0dWSEJ1YTBMbnhlYjdnakg3MXA4RTFUajlvUFVDT0lJdzMK"
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["app", "dmg", "deb", "appimage", "nsis"],
		"category": "DeveloperTool",
		"copyright": "© 2026 OpenNest",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"minimumSystemVersion": "10.15"
		}
	}
}
