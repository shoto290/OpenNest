{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "OpenNest",
	"version": "0.0.1",
	"identifier": "com.opennest.app",
	"build": {
		"beforeDevCommand": "bun run dev:web",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "OpenNest",
				"width": 1280,
				"height": 832,
				"minWidth": 1024,
				"minHeight": 680,
				"center": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": { "x": 18, "y": 24 }
			}
		]
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg"],
		"category": "DeveloperTool",
		"copyright": "© 2026 OpenNest",
		"shortDescription": "A desktop window for the Claude Code CLI.",
		"longDescription": "OpenNest drives the Claude Code CLI already installed on your machine as a local child process, and puts a chat window in front of it: streamed answers, tool activity, permission prompts, stop mid-turn, and session resume. No server sits in between.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"minimumSystemVersion": "10.15"
		}
	}
}
