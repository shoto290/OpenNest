{
	"name": "opennest",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shoto290/OpenNest.git"
	},
	"workspaces": [
		"packages/*",
		"apps/*",
		"apps/app/sidecar"
	],
	"packageManager": "bun@1.3.13",
	"scripts": {
		"dev": "turbo run dev",
		"storybook": "turbo run storybook",
		"build": "turbo run build",
		"tauri:build": "turbo run tauri:build",
		"test": "turbo run test",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"types": "turbo run types",
		"ci": "bun run lint && bun run types && bun run test",
		"release": "bun scripts/release.ts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@types/bun": "^1.3.14",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"turbo": "^2.9.6",
		"typescript": "^6.0.3"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md}": "biome check --write --no-errors-on-unmatched"
	}
}
