{
	"name": "@workspace/ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		"./globals.css": "./src/styles/globals.css",
		"./styles/*": "./src/styles/*",
		"./lib/*": "./src/lib/*.ts",
		"./components/*": [
			"./src/components/*.tsx",
			"./src/components/*.ts",
			"./src/components/*/index.tsx"
		],
		"./hooks/*": "./src/hooks/*.ts"
	},
	"scripts": {
		"types": "tsc -b",
		"lint": "biome lint",
		"lint:fix": "biome check --assist-enabled=true --unsafe --write .",
		"storybook": "storybook dev --port 6006 --no-open",
		"build-storybook": "storybook build",
		"test": "vitest run",
		"test:storybook": "vitest run --project=storybook"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@fontsource-variable/roboto": "^5.3.0",
		"@fontsource-variable/roboto-slab": "^5.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.31.0",
		"motion": "^13.1.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-markdown": "^10.1.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"shadcn": "^4.18.0",
		"shiki": "^4.4.3",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "10.5.5",
		"@storybook/addon-docs": "10.5.5",
		"@storybook/addon-mcp": "0.7.0",
		"@storybook/addon-themes": "10.5.5",
		"@storybook/addon-vitest": "10.5.5",
		"@storybook/react-vite": "10.5.5",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/browser": "4.1.10",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-v8": "4.1.10",
		"playwright": "1.62.1",
		"storybook": "10.5.5",
		"storybook-addon-pseudo-states": "10.5.5",
		"tailwindcss": "^4",
		"vite": "^8.0.0",
		"vitest": "4.1.10"
	}
}
